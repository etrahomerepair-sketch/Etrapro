---
pagination:
  data: services
  size: 1
  alias: service
permalink: "{{ service.slug }}.html"
---
{% extends "base.njk" %}

{% block head %}
<title>{{ service.meta_title }}</title>
<meta name="description" content="{{ service.meta_description }}">
<link rel="canonical" href="{{ site.url }}/{{ service.slug }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}/{{ service.slug }}">
<meta property="og:title" content="{{ service.meta_title }}">
<meta property="og:description" content="{{ service.meta_description }}">
<meta property="og:site_name" content="{{ site.company }}">
{%- if service.hero_image %}
<link rel="preload" as="image" href="images/{{ service.hero_image }}" fetchpriority="high">
{%- endif %}
{% set serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": service.name,
  "serviceType": service.name,
  "url": site.url + "/" + service.slug,
  "areaServed": { "@type": "AdministrativeArea", "name": site.service_area },
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": site.company,
    "telephone": site.phone_e164,
    "email": site.email,
    "url": site.url,
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": site.review_rating,
      "reviewCount": site.review_count
    }
  }
} %}
<script type="application/ld+json">{{ serviceSchema | dump | safe }}</script>
{%- if service.faqs %}
<script type="application/ld+json">{{ service.faqs | faqSchema | safe }}</script>
{%- endif %}
{% set breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": site.url + "/" },
    { "@type": "ListItem", "position": 2, "name": service.category | capitalize, "item": site.url + "/" + service.category },
    { "@type": "ListItem", "position": 3, "name": service.name, "item": site.url + "/" + service.slug }
  ]
} %}
<script type="application/ld+json">{{ breadcrumbSchema | dump | safe }}</script>
{% endblock %}

{% block styles %}{% include "lander-styles.njk" %}{% include "service-styles.njk" %}{% endblock %}

{% block body %}{% include "service-body.njk" %}
{%- set siblings = services | live | category(service.category) %}
{%- if siblings.length > 1 %}
<section class="related-strip">
  <div class="related-strip-inner">
    <span class="related-strip-tag">More {{ service.category }} work</span>
    <nav class="related-strip-links" aria-label="Related services">
      <a href="{{ service.category }}.html">All {{ service.category }}</a>
      {%- for s in siblings %}{% if s.slug != service.slug %}
      <a href="{{ s.slug }}.html">{{ s.nav_label }}</a>
      {%- endif %}{% endfor %}
    </nav>
  </div>
</section>
{%- endif %}{% endblock %}

{% block scripts %}{% include "service-scripts.njk" %}{% endblock %}
