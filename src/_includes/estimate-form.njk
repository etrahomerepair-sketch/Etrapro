{#- Shared estimate form. Callers set formSource, serviceOptions,
    serviceDefault and notesPlaceholder before including. -#}
<section class="estimate" id="estimate">
  <div class="wrap">
    <div class="form-card">
      <div class="form-fields" id="formFields">
        <h2>Get your free estimate in 30 seconds</h2>
        <p class="form-lead">Tell us about your project &mdash; owners review every request. No obligation.</p>
        <form id="estimateForm" name="estimate-request" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="estimate-request">
          <input type="hidden" name="source-page" value="{{ formSource }}">
          <p class="hp-field"><label>Leave this empty: <input name="bot-field"></label></p>
          <div class="form-grid cols-2 cols-desktop">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(782) 123-4567" required>
            </div>
            <div class="field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="you@email.com" required>
            </div>
            <div class="field">
              <label for="service">Service type</label>
              <select id="service" name="service" required>
                <option value="" disabled{% if not serviceDefault %} selected{% endif %}>Select a service</option>
                {%- for opt in serviceOptions %}
                <option{% if opt == serviceDefault %} selected{% endif %}>{{ opt }}</option>
                {%- endfor %}
              </select>
            </div>
            <div class="field span-2">
              <label for="city">City / area</label>
              <input id="city" name="city" type="text" placeholder="Halifax, Dartmouth, Bedford&hellip;" required>
            </div>
            <div class="field span-2 full span-4">
              <label for="notes">Notes</label>
              <textarea id="notes" name="notes" placeholder="{{ notesPlaceholder }}"></textarea>
            </div>
            <div class="field span-4 full">
              <button class="btn btn-primary form-submit" type="submit" id="formSubmit">Get my free estimate <span aria-hidden="true">&rarr;</span></button>
              <p class="form-note">No obligation. Owners review every request.</p>
            </div>
          </div>
        </form>
      </div>
      <div class="form-success" id="formSuccess" role="status" aria-live="polite">
        <div class="check" aria-hidden="true">&#10003;</div>
        <h3>Thanks &mdash; we&rsquo;ve got your request</h3>
        <p>Ravin or Ethan will follow up soon.<br>
        Need us sooner? Call <a href="tel:{{ site.phone_e164 }}"><strong>{{ site.phone_display }}</strong></a>
        or email <a href="mailto:{{ site.email }}"><strong>{{ site.email }}</strong></a>.</p>
      </div>
    </div>
  </div>
</section>

