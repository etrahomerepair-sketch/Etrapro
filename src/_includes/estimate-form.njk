{#- Shared estimate form. Callers set formSource, serviceOptions,
    serviceDefault and notesPlaceholder before including. -#}
{%- if not serviceOptions %}{%- set serviceOptions = site.form_options -%}{%- endif -%}
<section class="estimate" id="estimate">
  <div class="wrap">
    <div class="form-card">
      <div class="form-fields" id="formFields">
        <h2>Get your free estimate</h2>
        <p class="form-lead">Name, phone, service and area &mdash; email is optional. Owners review every request.</p>
        <form id="estimateForm" name="contact" method="POST" data-netlify="true" netlify-honeypot="bot-field" novalidate>
          <input type="hidden" name="form-name" value="contact">
          <input type="hidden" name="source-page" value="{{ formSource }}">
          <p class="hp-field"><label>Leave this empty: <input name="bot-field"></label></p>
          <div class="form-grid cols-2 cols-desktop">
            <div class="field">
              <label for="name">Name</label>
              <input id="name" name="name" type="text" autocomplete="name" placeholder="Your name" required>
            </div>
            <div class="field">
              <label for="phone">Phone</label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" placeholder="(782) 123-4567" required>
            </div>
            <div class="field">
              <label for="email">Email <span class="optional">(optional)</span></label>
              <input id="email" name="email" type="email" autocomplete="email" placeholder="you@email.com">
            </div>
            <div class="field">
              <label for="service">Service type</label>
              <select id="service" name="service" required>
                <option value="" disabled{% if not serviceDefault %} selected{% endif %}>Select a service</option>
                {%- for opt in serviceOptions %}
                <option{% if opt == serviceDefault %} selected{% endif %}>{{ opt }}</option>
                {%- endfor %}
              </select>
            </div>
            <div class="field span-2">
              <label for="city">City / area</label>
              <input id="city" name="city" type="text" placeholder="Halifax, Dartmouth, Bedford&hellip;" required>
            </div>
            <div class="field span-2 full span-4">
              <label for="notes">Notes</label>
              <textarea id="notes" name="message" placeholder="{{ notesPlaceholder }}"></textarea>
            </div>
            <div class="field span-4 full">
              <button class="btn btn-primary form-submit" type="submit" id="formSubmit">Get my free estimate <span aria-hidden="true">&rarr;</span></button>
              <p class="form-note">No obligation. Owners review every request.</p>
            </div>
          </div>
        </form>
      </div>
      <div class="form-success" id="formSuccess" role="status" aria-live="polite">
        <div class="check" aria-hidden="true">&#10003;</div>
        <h3>Thanks &mdash; we&rsquo;ve got your request</h3>
        <p>Ravin Anderson or Ethan Langille will follow up soon.<br>
        Need us sooner? Call <a href="tel:{{ site.phone_e164 }}"><strong>{{ site.phone_display }}</strong></a>
        or email <a href="mailto:{{ site.email }}"><strong>{{ site.email }}</strong></a>.</p>
      </div>
    </div>
  </div>
</section>

<script>
(function () {
  // Best-effort dual-write into Supabase so the app inbox + ntfy trigger see the request.
  // Netlify Forms stays primary; this never blocks or fails the visitor UX.
  var SUPABASE_URL = "https://qgydijfjkntkgpnuylev.supabase.co";
  var SUPABASE_ANON = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFneWRpamZqa250a2dwbnV5bGV2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIxNDc1NDYsImV4cCI6MjA4NzcyMzU0Nn0.Ell8giAbiYCAh6JfdfZ8plCbQZRhMzqHoY-SyTaM3yM";

  function uuid() {
    if (window.crypto && typeof crypto.randomUUID === "function") return crypto.randomUUID();
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      var r = (Math.random() * 16) | 0;
      var v = c === "x" ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  }

  function todayISO() {
    var d = new Date();
    return d.getFullYear() + "-" + String(d.getMonth() + 1).padStart(2, "0") + "-" + String(d.getDate()).padStart(2, "0");
  }

  window.etraWriteRequestToSupabase = function (form) {
    try {
      var fd = new FormData(form);
      var payload = {
        id: uuid(),
        date: todayISO(),
        name: String(fd.get("name") || "").trim() || null,
        phone: String(fd.get("phone") || "").trim() || null,
        email: String(fd.get("email") || "").trim() || null,
        service: String(fd.get("service") || "").trim() || null,
        location: String(fd.get("city") || "").trim() || null,
        message: String(fd.get("message") || "").trim() || null,
        status: "new"
      };
      fetch(SUPABASE_URL + "/rest/v1/requests", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "apikey": SUPABASE_ANON,
          "Authorization": "Bearer " + SUPABASE_ANON,
          "Prefer": "return=minimal"
        },
        body: JSON.stringify(payload)
      }).catch(function () { /* best-effort */ });
    } catch (e) { /* best-effort */ }
  };
})();
</script>
