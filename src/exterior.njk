{% extends "base.njk" %}

{% block head %}
<title>Decks, Fences &amp; Siding — Free Estimate | {{ site.company }} Halifax</title>
<meta name="description" content="Deck rebuilds, fences, and siding across Halifax &amp; HRM. Free estimate. {{ site.phone_display }}.">
<link rel="canonical" href="{{ site.url }}/exterior">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}/exterior">
<meta property="og:title" content="Decks, Fences &amp; Siding — Free Estimate | {{ site.company }} Halifax">
<meta property="og:description" content="Deck rebuilds, fences, and siding across Halifax &amp; HRM. Free estimate. {{ site.phone_display }}.">
<meta property="og:site_name" content="{{ site.company }}">
<link rel="preload" as="image" href="images/deck-finished.webp" fetchpriority="high">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Exterior restoration — decks, fences & siding",
  "serviceType": "Exterior restoration",
  "url": "{{ site.url }}/exterior",
  "areaServed": { "@type": "AdministrativeArea", "name": {{ site.service_area | dump | safe }} },
  "provider": {
    "@type": "HomeAndConstructionBusiness",
    "name": {{ site.company | dump | safe }},
    "telephone": "{{ site.phone_e164 }}",
    "email": "{{ site.email }}",
    "url": "{{ site.url }}",
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": {{ site.review_rating }},
      "reviewCount": {{ site.review_count }}
    }
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Exterior services",
    "itemListElement": [
      {%- for s in services | live | category("exterior") %}
      {"@type": "Offer", "itemOffered": {"@type": "Service", "name": {{ s.name | dump | safe }}, "url": "{{ site.url }}/{{ s.slug }}"}}{% if not loop.last %},{% endif %}
      {%- endfor %}
    ]
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{ site.url }}/"},
    {"@type": "ListItem", "position": 2, "name": "Exterior", "item": "{{ site.url }}/exterior"}
  ]
}
</script>
{% endblock %}

{% block styles %}{% include "lander-styles.njk" %}{% endblock %}
{% block body %}{% include "lander-body.njk" %}
<section class="related-strip" style="padding-top:0;padding-bottom:2.5rem;background:var(--bg);border-top:0">
  <div class="related-strip-inner">
    <span class="related-strip-tag">All exterior services</span>
    <nav class="related-strip-links" aria-label="Exterior services">
      {%- for s in services %}{% if not s.draft and s.category == "exterior" %}
      <a href="{{ s.slug }}.html">{{ s.nav_label }}</a>
      {%- endif %}{% endfor %}
    </nav>
  </div>
</section>{% endblock %}
{% block scripts %}{% include "lander-scripts.njk" %}{% endblock %}
